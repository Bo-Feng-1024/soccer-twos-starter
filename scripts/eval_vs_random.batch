#!/bin/bash

# Evaluate the submitted reward_shaping_ppo_agent against selfmade_random_agent.
# 100 matches; result is appended to report/eval_vs_random_pace.log.

#SBATCH --job-name=eval_vs_random
#SBATCH -N1 --ntasks-per-node=8
#SBATCH --mem-per-cpu=4G
#SBATCH -t01:00:00
#SBATCH --output=eval_vs_random-%j.out
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=bfeng66@gatech.edu

source ~/miniconda3/etc/profile.d/conda.sh 2>/dev/null || module load anaconda3
conda activate soccertwos

# Match the working environment used for training (ray==1.4.0)
export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
export RAY_DISABLE_IMPORT_WARNING=1
export RAY_DASHBOARD_DISABLED=1
export PYTHONUNBUFFERED=1

# Clean up any leftover Unity / Ray processes from previous runs on the same node
pkill -u $USER -f soccer || true
pkill -u $USER -f Unity || true
ray stop --force 2>/dev/null || true

mkdir -p report
python -u scripts/eval_vs_random.py 100 2>&1 | tee report/eval_vs_random_pace.log
